# Local .terraform directories - ANYWHERE in the project
**/.terraform/
**/.terraform/*
.terraform/
.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files except example
*.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Lock file
.terraform.lock.hcl

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# PowerShell
*.ps1xml

# Any large binaries
*.exe
*.zip
*.tar.gz
*.7z
