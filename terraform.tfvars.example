project_name = "netlab"
environment  = "dev"
location     = "eastus"
alert_email  = "your-email@example.com"

vnet_address_space = ["10.1.0.0/16"]

subnet_config = {
  web = {
    name             = "snet-web"
    address_prefixes = ["10.1.1.0/24"]
    purpose          = "Web tier"
  }
  app = {
    name             = "snet-app"
    address_prefixes = ["10.1.2.0/24"]
    purpose          = "App tier"
  }
  data = {
    name             = "snet-data"
    address_prefixes = ["10.1.3.0/24"]
    purpose          = "Data tier"
  }
  mgmt = {
    name             = "snet-mgmt"
    address_prefixes = ["10.1.4.0/24"]
    purpose          = "Management"
  }
}
